# SENTINEL execution environment template.
# Copy to .env and fill in real values; .env is gitignored and must never be
# committed.

# --- LLM adapter configuration ---
SENTINEL_LLM_PROVIDER=openai
SENTINEL_LLM_MODEL=
SENTINEL_LLM_TIMEOUT_MS=30000
SENTINEL_LLM_PROMPT_REVISION=prompt-v4-complete-constraints
SENTINEL_LLM_TOOL_POLICY_REVISION=legal-tools-v2
SENTINEL_LLM_API_KEY_ENV=OPENAI_API_KEY

# --- Proposal evaluation consent (blank by default) ---
# The evaluation manifest digest is unique to each reviewed dry run. Copy that
# run's authorization_sha256 here only for its matching --execute invocation.
SENTINEL_PROPOSAL_EVAL_CONSENT=
# Provider-specific consent remains separate from the per-manifest digest.
SENTINEL_JEV_PROPOSER_CONSENT=
SENTINEL_LLM_PROPOSER_CONSENT=
# Expected resolved model identities and their decision notes are supplied as
# --expected-resolved-model and --identity-decision-note CLI arguments.

# --- Credentials (placeholders only; values stay local) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Drone / network ---
SENTINEL_LOCAL_IP=
