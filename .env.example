# SENTINEL execution environment template.
# Copy to .env and fill in real values; .env is gitignored and must never be
# committed.

# --- LLM adapter configuration ---
SENTINEL_LLM_PROVIDER=openai
SENTINEL_LLM_MODEL=
SENTINEL_LLM_TIMEOUT_MS=30000
SENTINEL_LLM_PROMPT_REVISION=prompt-v3
SENTINEL_LLM_TOOL_POLICY_REVISION=
SENTINEL_LLM_API_KEY_ENV=OPENAI_API_KEY

# --- Credentials (placeholders only; values stay local) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Drone / network ---
SENTINEL_LOCAL_IP=
