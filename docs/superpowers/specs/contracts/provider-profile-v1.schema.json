  "allOf":[{"if":{"properties":{"approval_status":{"const":"APPROVED"}}},"then":{"properties":{"selection_decision_id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},"model":{"type":"string","minLength":1},"model_revision":{"type":"string","minLength":1},"prompt_revision":{"type":"string","minLength":1},"transform_revision":{"type":"string","minLength":1},"evaluation_pack_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"score_semantics":{"type":"string","minLength":1},"decision_threshold":{"type":"number"},"max_p95_latency_ms":{"type":"integer"},"max_provider_failure_rate":{"type":"number"}}}}]
